# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Dev tooling — NOT part of the CXMR template (the template is cloned per-program).
# UnrealAgent: in-editor MCP server (Claude bridge). .mcp.json: machine-local MCP config.
Plugins/UnrealAgent/
.mcp.json

# Agent skills installed via the `skills` CLI. Kept global (user-level), not per-repo,
# so if a project-scope install ever lands here, don't commit it.
.agents/
.claude/skills/
skills-lock.json

# Machine-local agent settings (skill 노출 조절 등). 템플릿에 커밋되는 건
# .claude/settings.json 뿐 — skill/MCP 설정은 여기 두고 리포에서 뺀다.
.claude/settings.local.json

# Varjo / UE 템플릿에서 넘어온 샘플 콘텐츠 — CXMR 템플릿의 일부가 아니다.
# 프로그램별 프로젝트에서 필요하면 각자 임포트한다.
Content/VRTemplate/
Content/VarjoContent/
Content/VRSpectator/
Content/Characters/
Content/FPWeapon/
Content/LevelPrototyping/
Content/VRMultiPawnGameMode.uasset
